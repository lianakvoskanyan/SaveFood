NEXT_PUBLIC_SANITY_PROJECT_ID=lp13wbnx
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Server-only write token for reservations, account creation, and dashboards.
# Use a token with the minimum required write permissions; never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Local email/password auth. Keep both values stable; changing either makes
# existing account records or sessions inaccessible.
# Generate AUTH_DATA_ENCRYPTION_KEY with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_DATA_ENCRYPTION_KEY=
# Generate NEXTAUTH_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Comma-separated account emails allowed to access /admin-dashboard.
FOODSAVE_ADMIN_EMAILS=
